# ==================================================
# RESOURCEAI CONFIGURATION (Template)
# ==================================================

# Server Configuration
PORT=5055
NODE_ENV=development
DATABASE_PATH=./server/data/resourceai.db
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=resourceai_emergency_super_secret_jwt_key_2026

# Exotel Credentials & Settings (Configure using env vars only; never commit real keys to Git)
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_VIRTUAL_NUMBER=+918047359000
EXOTEL_PHONE_NUMBER=+918047359000
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_REGION=singapore
EXOTEL_WEBHOOK_SECRET=your_exotel_webhook_secret_key

# Public Host / Base URL (for ngrok / reverse proxy tunnel in development)
# e.g., debug-unworn-clutter.ngrok-free.dev (Voicebot WSS will be wss://<PUBLIC_HOST>/api/voice/exotel/stream)
PUBLIC_HOST=your-subdomain.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:5055

# AI Provider Settings (ollama / openai / mock)
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
AI_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=

# Speech-To-Text (STT) Provider (local / openai / mock)
STT_PROVIDER=local
LOCAL_WHISPER_MODEL=base
WHISPER_DAEMON_URL=http://127.0.0.1:5056
STT_API_KEY=

# Text-To-Speech (TTS) Provider (local / openai / mock)
TTS_PROVIDER=local
TTS_API_KEY=

# Audio Stream Format Configuration
# Exotel AgentStream default is 8000 Hz, mono PCM or mu-law (audio/x-mulaw or audio/l16)
EXOTEL_AUDIO_CODEC=audio/l16
EXOTEL_SAMPLE_RATE=8000
