{
  "name": "resource-ai",
  "version": "1.0.0",
  "description": "ResourceAI - AI-Powered Multilingual Disaster Emergency Response & Resource Allocation Platform",
  "type": "module",
  "main": "server/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "whisper": "python server/ai/whisper_service.py --server",
    "client": "npm run --prefix client dev",
    "dev": "npm run --prefix client dev",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run dev\"",
    "build": "npm run --prefix client build",
    "postinstall": "npm install --prefix client",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "disaster-response",
    "emergency-ai",
    "exotel",
    "agentstream",
    "voicebot",
    "resource-allocation"
  ],
  "author": "ResourceAI Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
